entry 0x00001000

section .data
    KERN_START def 0x00021000
    VIDEO_BUFF def 0x00061000
    INITIAL_STACK def 0x0007FFFF
    IDT_ADDR def 0x00063000

    jmp_table def $
    jmp_table_len def 2
    dd 0 ; BIOS_print
    dd 0 ; BIOS_sprint

section .code
int80_handler:
    pusha

    mul a, 4

    cmp a, jmp_table_len
    jl [jmp_table + a]

    mov a, 0xFFFFFFFF ; error

    popa
    iret

main:
    cli

    lidt IDT_ADDR ; setup default idt
    movd [IDT_ADDR + 0x280], int80_handler ; int 0x80
    movd [IDT_ADDR + 0x284], 0 ; iopl = 0

    mdump IDT_ADDR+0x280, 6
    mov sp, INITIAL_STACK

    ; set the IOPL to 1 before jumping to kernel
    setf 0b0010000

    call KERN_START
    jmp $


; b = msg, c = len
BIOS_print:
    mul c, 2
    mov d, VIDEO_BUFF
    add c, VIDEO_BUFF

print_internal:
    movb [d], [b]

    add d, 1
    movb [d], 0x07 ; white

    add b, 1
    add d, 1

    cmp d, c
    jge end_print
    jmp print_internal

end_print:
    in 0x0200, 0 ; update screen

    popa
    iret

; b = msg, c = len
BIOS_sprint:
    in 0x0100, [b]
    
    add b, 1
    sub c, 1
    cmp c, 0
    jnz BIOS_sprint

    popa
    iret
