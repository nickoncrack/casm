    entry 0x00021000

section .data
    ; constant addresses
    BIOS_MEM        def 0x00019000
    IDT_ADDR        def 0x00063000
    INITIAL_STACK   def 0x0007FFFF
    KERNEL_MEM      def 0x00080000
    PT_END          def 0x00580000
    POOL_REGION     def 0xC0000000


    ; pool sizes (entries) = 512 KiB
    POOL8_SIZE      def 0x300
    POOL32_SIZE     def 0x240
    POOL64_SIZE     def 0x180
    POOL128_SIZE    def 0x100
    POOL256_SIZE    def 0x100
    POOL1024_SIZE   def 0x70
    POOL4096_SIZE   def 0x40

    PAGE_SIZE       def 0x1000
    POOL_SIZE       def 0x80000 ; 128 pages


    ; string definitions
    int0_len def 22
    int0_msg db "Division by zero error"

    int1_len def 24
    int1_msg db "Invalid opcode exception"

    int4_len def 70
    int4_msg db "Attempted to execute a privileged instruction in non-privileged space."

    panic1_len def 43
    panic1_msg db "Kernel panic: Unhandled exception interrupt"

    init1_len def 19
    init1_msg db "Early init complete"

    ; struct type definitions
    struct page_t
        phy_addr dd

        ; present: 1
        ; kernel: 1
        ; perms: 3
        ; reserved: 4
        params db
    end_struct

    struct idt_entry_t
        addr dd

        ; current iopl: 3
        ; reserved: 5
        params db
    end_struct

    struct hwinfo_t
        mem_size dd
    end_struct

    ; must strictly be in this order
    struct regs_t
        sp dd
        d dd
        c dd
        b dd
        a dd
        int_no db
        err_code db
        flags dw
        ip dd
    end_struct

    
    ; struct definitions
    hwinfo ds hwinfo_t
    page ds page_t
    idt_entry ds idt_entry_t
    regs ds regs_t


    ; variable addresses
    FBM_END dd 0 ; frame bitmap end
    INT_END dd 0 ; interrupt handler table end
    
    POOL8_END       dd 0
    POOL32_END      dd 0
    POOL64_END      dd 0
    POOL128_END     dd 0
    POOL256_END     dd 0
    POOL1024_END    dd 0
    POOL4096_END    dd 0

    ; first available block
    pool8_head      dw 0
    pool32_head     dw 0
    pool64_head     dw 0
    pool128_head    dw 0
    pool256_head    dw 0
    pool1024_head   dw 0
    pool4096_head   dw 0


section .code

; @params: none
; @return: a = physical address
; @clobbers: a, b, c, d
alloc_frame:
    pusha
    mov a, PT_END

alloc_frame_loop:
    movd b, [FBM_END]
    cmp a, b
    jge no_frames

    movd b, [a]
    cmp b, 0xFFFFFFFF ; check if all bits are set
    jne alloc_frame_found

    add a, 4
    jmp alloc_frame_loop

alloc_frame_found:
    push a

    ; logic: ~(b & (1 << a)) == 1 -> found
    mov a, 0
    mov c, b
    mov d, 1

    lsh d, a ; d << a
    and c, d ; c &= d
    add a, 1

    cmp c, 0
    jnz $-60

    ; set bit
    pop c ; pop old a value to c
    or b, d
    movd [c], b

    sub a, 1 ; rightmost unset bit
    mov b, 31
    sub b, a ; b = 31 - a

    sub c, PT_END

    ; c -> byte index, b -> bit index
    ; PA = 8*4096*c + 4096*b
    mul c, 0x8000
    mul b, 0x1000

    add c, b
    mov r0, c ; popa doesn't pop r0

    popa
    mov a, r0
    mov r0, 0

    ret

no_frames:
    popa
    mov a, 0

    ret


; @params: a = VA, b = kernel
; @return: a = 0 success, a = 1 page already exists
; @clobbers: a, b, c, d
alloc_page:
    pusha

    div PAGE_SIZE ; floor division, will automatically align to page size KiB
    
    ; calculate address of page entry
    mul a, #page_t
    add a, KERNEL_MEM ; page table lives at the start of kernel data
    movs [page], [a]

    movb c, [page.params]
    and c, 0b10000000 ; present bit 

    cmp c, 0
    jnz alloc_page_exists

    mov d, a
    call alloc_frame

    movd [page.phy_addr], a
    mov a, 0b10000000
    lsh b, 7
    or a, b
    movb [page.params], a

    movs [d], [page]

    popa
    movd a, [page.phy_addr] ; test
    ret

alloc_page_exists:
    mov a, 1
    ret


; @params: a = interrupt number, b = handler address
; @return: a = 0 success, a = 1 error
; @clobbers: a
set_idt_entry:
    cmp a, 0x80 ; cannot overwrite the bios interrupt
    je set_idt_entry_error

    pusha
    mul a, #idt_entry_t
    add a, IDT_ADDR

    movd [idt_entry.addr], b
    movb [idt_entry.params], 0b00100000 ; iopl = 1
    movs [a], [idt_entry]

    popa
    mov a, 0
    ret

set_idt_entry_error:
    mov a, 1
    ret


int00:
    cli
    push 0x00 ; int_no
    jmp int_common_stub

int01:
    cli
    push 0x01
    jmp int_common_stub

int02:
    cli
    push 0x02
    jmp int_common_stub

int03:
    cli
    push 0x03
    jmp int_common_stub

int04:
    cli
    push 0x04
    jmp int_common_stub

int05:
    cli
    push 0x05
    jmp int_common_stub

int06:
    cli
    push 0x06
    jmp int_common_stub

int07:
    cli
    push 0x07
    jmp int_common_stub

int08:
    cli
    push 0x08
    jmp int_common_stub

int09:
    cli
    push 0x09
    jmp int_common_stub

int0a:
    cli
    push 0x0a
    jmp int_common_stub

int0b:
    cli
    push 0x0b
    jmp int_common_stub

int0c:
    cli
    push 0x0c
    jmp int_common_stub

int0d:
    cli
    push 0x0d
    jmp int_common_stub

int0e:
    cli
    push 0x0e
    jmp int_common_stub

int0f:
    cli
    push 0x0f
    jmp int_common_stub

int10:
    cli
    push 0x10
    jmp int_common_stub

int11:
    cli
    push 0x11
    jmp int_common_stub

int12:
    cli
    push 0x12
    jmp int_common_stub

int13:
    cli
    push 0x13
    jmp int_common_stub

int14:
    cli
    push 0x14
    jmp int_common_stub

int15:
    cli
    push 0x15
    jmp int_common_stub

int16:
    cli
    push 0x16
    jmp int_common_stub

int17:
    cli
    push 0x17
    jmp int_common_stub

int18:
    cli
    push 0x18
    jmp int_common_stub

int19:
    cli
    push 0x19
    jmp int_common_stub

int1a:
    cli
    push 0x1a
    jmp int_common_stub

int1b:
    cli
    push 0x1b
    jmp int_common_stub

int1c:
    cli
    push 0x1c
    jmp int_common_stub

int1d:
    cli
    push 0x1d
    jmp int_common_stub

int1e:
    cli
    pushb 0x1e
    jmp int_common_stub

int1f:
    cli
    pushb 0x1f
    jmp int_common_stub

int20:
    cli
    push 0      ; err_code
    push 0x20   ; int_no
    jmp int_common_stub


int_common_stub:
    pusha
    push sp

    call int_handler
    add sp, 4 ; discard pushed sp

    popa
    add sp, 8 ; discard pushed error code and interrupt number
    iret

int_handler:
    add sp, 5 ; 1 byte + pushed ip by call int_handler
    movs [regs], [sp]
    sub sp, 5

    movb a, [regs.int_no]
    mul a, 4                ; get offset
    addd a, [FBM_END]       ; get address
    movd b, [a]             ; dereference the address

    cmp b, 0
    jz int_handler_0 ; unhandled interrupt

    call b
    ret

int_handler_0:
    ; check if interrupt is an exception
    cmp a, 0x1F
    jle int_handler_panic

    ret ; unhandled IRQs don't cause a kernel panic

int_handler_panic:
    ; bios return address
    mov sp, INITIAL_STACK-4

    mov a, 0
    mov b, panic1_msg
    mov c, panic1_len
    int 0x80

    ret ; pops the return ip bios pushed when kernel entry was called


main:
    ; read hwinfo from bios data start
    mov a, BIOS_MEM
    movs [hwinfo], [a]
    movd a, [hwinfo.mem_size]
    div 4 ; get memory size in pages
    div 8 ; get frame table size in bytes
    
    cmp d, 0 ; remainder has to be 0
    sz

    ; set frame table end
    add a, PT_END
    movd [FBM_END], a

    ; the first 4096 frames are already allocated
    ; the frame entry width is 1 bit so the initial frame table is 512 bytes
    mov c, PT_END

loop_ft_1:
    cmp c, PT_END+512
    jge main_1

    movd [c], 0xFFFFFFFF
    add c, 4
    jmp loop_ft_1

main_1:
    ; the other frames are unused so no need to allocate them

    mov c, 0 ; interrupt number
    mov d, 0 ; function offset = int * 30

set_int_handlers:
    cmp c, 0x1F
    jg main_2

    mov a, c
    mov b, int00+d
    call set_idt_entry
    
    cmp a, 0
    sz ; assert a == 0

    add c, 1
    add d, 30

    jmp set_int_handlers

main_2:
    ; allocate pool pages
    mov a, POOL_SIZE
    div PAGE_SIZE

    ; pool size must be an integer multiple of the page size
    cmp d, 0
    sz

    mov c, a ; number of pages to allocate
    xor d, d ; current page
    mul c, PAGE_SIZE

    ; alloc_page parameters
    xor a, a
    mov b, 1 ; kernel page

; allocate pages
pool_stage1:
    cmp d, c
    jge pool_stage2

    mov a, d
    add a, POOL_REGION
    call alloc_page

    add d, PAGE_SIZE
    jmp pool_stage1

; write "next free block" values and set addresses
pool_stage2:
    mov a, POOL_REGION

    mov b, POOL8_SIZE
    mul b, 8
    add a, b
    movd [POOL8_END], a

    mov b, POOL32_SIZE
    mul b, 32
    add a, b
    movd [POOL32_END], a

    mov b, POOL64_SIZE
    mul b, 64
    add a, b
    movd [POOL64_END], a

    mov b, POOL128_SIZE
    mul b, 128
    add a, b
    movd [POOL128_END], a

    mov b, POOL256_SIZE
    mul b, 256
    add a, b
    movd [POOL256_END], a

    mov b, POOL1024_SIZE
    mul b, 1024
    add a, b
    movd [POOL1024_END], a

    mov b, POOL4096_SIZE
    mul b, 4096
    add a, b
    movd [POOL4096_END], a

    pushw POOL4096_SIZE
    pushw 4096
    pushw POOL1024_SIZE
    pushw 1024
    pushw POOL256_SIZE
    pushw 256
    pushw POOL128_SIZE
    pushw 128
    pushw POOL64_SIZE
    pushw 64
    pushw POOL32_SIZE
    pushw 32
    pushw POOL8_SIZE
    pushw 8

    mov a, POOL_REGION  ; current address
    xor c, c            ; loop counter

; iterate through all pools
pool_loop1:
    cmp c, 7 ; npools
    jge early_init_done

    popw b ; pool block size
    popw d ; pool size in blocks

    push c ; only the loop counter needs to be restored
    mov c, 1 ; inner loop counter
    call pool_loop2
    pop c

    add c, 1
    add a, b ; go to pool end
    jmp pool_loop1

; iterate through all blocks
pool_loop2:
    cmp c, d
    jg pool_loop2_end

    movw [a], c ; write next block index

    add a, b
    add c, 1
    jmp pool_loop2

pool_loop2_end:
    sub a, b            ; go to last block
    movw [a], 0xFFFF    ; write last block

    ret


; @params: a = allocation size
; @return: a = address
; @clobbers: a, c
kmalloc:
    push c

    cmp a, 8
    jle __kmalloc_8

    cmp a, 32
    jle __kmalloc_32

    cmp a, 64
    jle __kmalloc_64

    cmp a, 128
    jle __kmalloc_128

    cmp a, 256
    jle __kmalloc_256

    cmp a, 1024
    jle __kmalloc_1024

    cmp a, 4096
    jle __kmalloc_4096

    ; request size too large
    xor a, a

    pop c
    ret

__kmalloc_8:
    movw a, [pool8_head]
    cmp a, 0xFFFF
    je __kmalloc_no_available_blocks

    mul a, 8            ; offset in pool
    add a, POOL_REGION  ; global address
    movw c, [a]         ; next free block
    movw [pool8_head], c ; update head

    pop c
    ret

__kmalloc_32:
    movw a, [pool32_head]
    cmp a, 0xFFFF
    je __kmalloc_no_available_blocks

    mul a, 32
    addd a, [POOL8_END]
    movw c, [a]
    movw [pool32_head], c

    pop c
    ret

__kmalloc_64:
    movw a, [pool64_head]
    cmp a, 0xFFFF
    je __kmalloc_no_available_blocks

    mul a, 64
    addd a, [POOL32_END]
    movw c, [a]
    movw [pool32_head], c

    pop c
    ret

__kmalloc_128:
    movw a, [pool128_head]
    cmp a, 0xFFFF
    je __kmalloc_no_available_blocks

    mul a, 128
    addd a, [POOL64_END]
    movw c, [a]
    movw [pool128_head], c

    pop c
    ret

__kmalloc_256:
    movw a, [pool256_head]
    cmp a, 0xFFFF
    je __kmalloc_no_available_blocks

    mul a, 256
    addd a, [POOL128_END]
    movw c, [a]
    movw [pool256_head], c

    pop c
    ret

__kmalloc_1024:
    movw a, [pool1024_head]
    cmp a, 0xFFFF
    je __kmalloc_no_available_blocks

    mul a, 1024
    addd a, [POOL256_END]
    movw c, [a]
    movw [pool1024_head], c

    pop c
    ret

__kmalloc_4096:
    movw a, [pool4096_head]
    cmp a, 0xFFFF
    je __kmalloc_no_available_blocks

    mul a, 4096
    addd a, [POOL1024_END]
    movw c, [a]
    movw [pool4096_head], c

    pop c
    ret

__kmalloc_no_available_blocks:
    mov a, 0xFFFFFF
    ret


; @params: a = address
; @return: a = 0 success, a = 1 out of bounds
; @clobbers: a, b, d
kfree:
    ; check if address is within bounds
    cmp a, POOL_REGION
    jl __kfree_oob
    cmpd a, [POOL4096_END]
    jge __kfree_oob

    push b
    push d
    mov b, a ; save address

    cmpd a, [POOL8_END]
    jl __kfree_8

    cmpd a, [POOL32_END]
    jl __kfree_32

    cmpd a, [POOL64_END]
    jl __kfree_64

    cmpd a, [POOL128_END]
    jl __kfree_128

    cmpd a, [POOL256_END]
    jl __kfree_256

    cmpd a, [POOL1024_END]
    jl __kfree_1024

    cmpd a, [POOL4096_END]
    jl __kfree_4096

    ; should never reach this point
    pop d
    pop b
    mov a, 0xFFFFFFFF
    ret

__kfree_8:
    ; calculate block index
    sub a, POOL_REGION
    div 8

    sub b, d ; base block index in case a mod POOL_REGION = 0
    movw [b], [pool8_head] ; write next free block
    movw [pool8_head], a ; block freed is marked as next free block

    jmp __kfree_end

__kfree_32:
    subd a, [POOL8_END]
    div 32

    sub b, d
    movw [b], [pool32_head]
    movw [pool32_head], a
    jmp __kfree_end

__kfree_64:
    subd a, [POOL32_END]
    div 64

    sub b, d
    movw [b], [pool64_head]
    movw [pool64_head], a
    jmp __kfree_end

__kfree_128:
    subd a, [POOL64_END]
    div 128

    sub b, d
    movw [b], [pool128_head]
    movw [pool128_head], a
    jmp __kfree_end

__kfree_256:
    subd a, [POOL128_END]
    div 256

    sub b, d
    movw [b], [pool256_head]
    movw [pool256_head], a
    jmp __kfree_end

__kfree_1024:
    subd a, [POOL256_END]
    div 1024

    sub b, d
    movw [b], [pool1024_head]
    movw [pool1024_head], a
    jmp __kfree_end

__kfree_4096:
    subd a, [POOL1024_END]
    div 4096

    sub b, d
    movw [b], [pool4096_head]
    movw [pool4096_head], a
    jmp __kfree_end

__kfree_oob:
    mov a, 1
    ret

__kfree_end:
    pop d
    pop b
    xor a, a
    ret


early_init_done:
    mov a, 8
    call kmalloc
    mdump 0xC0000000, 8

    movd [a], 0xFFFFFFFF
    add a, 4
    movd [a], 0xFFFFFFFF
    mdump 0xC0000000, 8

    call kfree
    mdump 0xC0000000, 8

    mov a, 8
    call kmalloc

    dump
    end
